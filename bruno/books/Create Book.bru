meta {
  name: Create Book
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "The Pragmatic Programmer",
    "author": "David Thomas, Andrew Hunt",
    "isbn": "9780135957059",
    "description": "A guide to becoming a better programmer.",
    "genre": "Technology",
    "language": "English",
    "condition": "GOOD"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("bookId", res.body.id);
  }
}
