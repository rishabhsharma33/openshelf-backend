# Pooled Postgres connection string (Neon: the -pooler host, with ?pgbouncer=true appended)
DATABASE_URL=

# Direct (non-pooled) Postgres connection string, used only by Prisma Migrate
DIRECT_URL=

# Port the server listens on (defaults to 3000 if omitted)
PORT=3000

# Secret used to sign JWT access tokens
JWT_SECRET=

# JWT expiry, e.g. 1d, 15m
JWT_EXPIRES_IN=1d

# Salt rounds used when hashing passwords with bcrypt
BCRYPT_SALT_ROUNDS=10

# Cloudinary account credentials, from your Cloudinary dashboard (Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed CORS origins. Leave unset to allow any origin.
CORS_ORIGIN=
