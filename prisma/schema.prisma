generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String

  phone        String?
  city         String?
  state        String?

  profileImage String?
  bio          String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}